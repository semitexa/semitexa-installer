{
    "name": "semitexa/installer",
    "description": "Semitexa Installer - the project scaffold (bin/semitexa, Dockerfile, Compose files) and the image that writes it into a new project",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Installer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Installer\\Tests\\": "tests/"
        }
    },
    "keywords": [
        "semitexa",
        "installer",
        "scaffold",
        "docker"
    ]
}
